---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "GNA Works — Executive Architecture", 
	description = "Building profitable businesses and producing breakthrough results for the construction and restoration industry." 
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/gna-favicon.svg?v=1" />
		<meta name="generator" content={Astro.generator} />
		
		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- Apple Touch Icon -->
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		
		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="GNA Works" />
		<meta property="og:image" content="/og-image.png" />
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:image" content="/og-image.png" />

		<!-- Smooth Scroll and Viewport -->
		<meta name="theme-color" content="#fdfdfc" />

		<script is:inline defer src="https://umami-production-fa9c.up.railway.app/script.js" data-website-id="e593c469-a145-4619-ac33-ea8dd1f685be"></script>
	</head>
	<body>
		<div class="fixed inset-0 pointer-events-none opacity-[0.03] bg-[url('/noise.svg')] mix-blend-overlay z-[9999]"></div>
		<slot />
	</body>
</html>
