---
import IndustrialLayout from '../layouts/IndustrialLayout.astro';
import Navbar from '../components/industrial/Navbar.svelte';
import Estimator from '../components/industrial/Estimator.svelte';
import Contact from '../components/industrial/Contact.svelte';
import Footer from '../components/industrial/Footer.svelte';
import FloatingPhone from '../components/industrial/FloatingPhone.svelte';
---

<IndustrialLayout
	title="Project Estimator | Hoehne Property Maintenance & Remodeling"
	description="Rough project estimator for Hoehne Property Maintenance & Remodeling in Pottstown, PA."
	canonical="https://www.hoehnepropertymaintenance.com/estimate"
>
	<main class="relative bg-paper selection:bg-hivis selection:text-white pt-16 lg:pt-20">
		<Navbar client:load />
		<Estimator client:load />
		<Contact client:load />
		<Footer client:load />
	</main>
	<FloatingPhone client:load />
</IndustrialLayout>
