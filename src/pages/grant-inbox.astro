---
import IndustrialLayout from '../layouts/IndustrialLayout.astro';
import { getChatSession, listChatSessions } from '../lib/server/chat-store';

export const prerender = false;

const expectedToken = import.meta.env.GRANT_INBOX_TOKEN;
const providedToken = Astro.url.searchParams.get('token')?.trim() ?? '';
const requestedSessionId = Astro.url.searchParams.get('session')?.trim() ?? '';
const authorized = Boolean(expectedToken) && providedToken === expectedToken;

const recentSessions = authorized ? await listChatSessions(60) : [];
const requestedSession =
    authorized && requestedSessionId ? await getChatSession(requestedSessionId) : null;
const sessions =
    requestedSession && !recentSessions.some((session) => session.sessionId === requestedSession.sessionId)
        ? [requestedSession, ...recentSessions]
        : recentSessions;
const selectedSession = requestedSession ?? sessions[0] ?? null;

const bookedCount = sessions.filter((session) => session.booked).length;
const emailedCount = sessions.filter((session) => session.summarySentAt).length;
const knownLeadCount = sessions.filter((session) => session.leadEmail || session.leadName).length;
const improvementNotes = sessions
    .map((session) => session.summaryJson?.noteToImproveGrant?.trim())
    .filter((note): note is string => Boolean(note))
    .filter((note, index, allNotes) => allNotes.indexOf(note) === index)
    .slice(0, 6);

function formatTimestamp(value: string | null) {
    if (!value) return '—';

    return new Intl.DateTimeFormat('en-US', {
        dateStyle: 'medium',
        timeStyle: 'short',
    }).format(new Date(value));
}

function buildSessionHref(sessionId: string) {
    const params = new URLSearchParams({
        session: sessionId,
        token: providedToken,
    });

    return `/grant-inbox?${params.toString()}`;
}
---

<IndustrialLayout title="Grant Inbox | GNA Works" description="Internal Grant chat summaries and transcripts.">
    <main class="min-h-screen px-6 py-10 md:px-10">
        <div class="mx-auto max-w-7xl space-y-8">
            <header class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
                <div>
                    <p class="text-[0.7rem] uppercase tracking-[0.18em] text-ind-accent/80">Internal View</p>
                    <h1 class="mt-2 text-3xl font-black uppercase tracking-[0.08em] text-white">Grant Inbox</h1>
                    <p class="mt-3 max-w-3xl text-sm leading-6 text-ind-steel">
                        Every saved Grant conversation in one place, plus the practical note on how to tighten Grant from
                        what real visitors actually say.
                    </p>
                </div>

                {authorized && (
                    <div class="grid grid-cols-3 gap-3 text-center text-xs uppercase tracking-[0.12em] md:w-[360px]">
                        <div class="border border-ind-border/60 bg-black/40 px-3 py-4">
                            <div class="text-2xl font-black text-white">{sessions.length}</div>
                            <div class="mt-1 text-ind-steel">Chats</div>
                        </div>
                        <div class="border border-ind-border/60 bg-black/40 px-3 py-4">
                            <div class="text-2xl font-black text-white">{bookedCount}</div>
                            <div class="mt-1 text-ind-steel">Booked</div>
                        </div>
                        <div class="border border-ind-border/60 bg-black/40 px-3 py-4">
                            <div class="text-2xl font-black text-white">{emailedCount}</div>
                            <div class="mt-1 text-ind-steel">Emailed</div>
                        </div>
                    </div>
                )}
            </header>

            {!authorized ? (
                <section class="border border-red-500/40 bg-black/40 p-6">
                    <p class="text-sm uppercase tracking-[0.14em] text-red-300">Access denied</p>
                    <p class="mt-3 max-w-2xl text-sm leading-6 text-ind-steel">
                        This page needs a valid inbox token in the query string.
                    </p>
                </section>
            ) : (
                <>
                    <section class="grid gap-4 lg:grid-cols-[1.4fr_1fr]">
                        <div class="border border-ind-border/60 bg-black/35 p-6">
                            <p class="text-[0.68rem] uppercase tracking-[0.16em] text-ind-accent/80">What Grant should learn</p>
                            <div class="mt-4 grid gap-3">
                                {improvementNotes.length > 0 ? (
                                    improvementNotes.map((note) => (
                                        <div class="border border-ind-border/40 bg-[#111] px-4 py-3 text-sm leading-6 text-white/90">
                                            {note}
                                        </div>
                                    ))
                                ) : (
                                    <div class="border border-ind-border/40 bg-[#111] px-4 py-3 text-sm leading-6 text-ind-steel">
                                        No summary notes yet. Once chats are finalized, the tuning notes will show up here.
                                    </div>
                                )}
                            </div>
                        </div>

                        <div class="border border-ind-border/60 bg-black/35 p-6">
                            <p class="text-[0.68rem] uppercase tracking-[0.16em] text-ind-accent/80">Capture quality</p>
                            <dl class="mt-4 space-y-4 text-sm leading-6 text-ind-steel">
                                <div class="flex items-center justify-between gap-4 border-b border-ind-border/30 pb-3">
                                    <dt>Known leads</dt>
                                    <dd class="font-bold text-white">{knownLeadCount}</dd>
                                </div>
                                <div class="flex items-center justify-between gap-4 border-b border-ind-border/30 pb-3">
                                    <dt>Summary emails sent</dt>
                                    <dd class="font-bold text-white">{emailedCount}</dd>
                                </div>
                                <div class="flex items-center justify-between gap-4">
                                    <dt>Latest update</dt>
                                    <dd class="font-bold text-white">
                                        {selectedSession ? formatTimestamp(selectedSession.updatedAt) : '—'}
                                    </dd>
                                </div>
                            </dl>
                        </div>
                    </section>

                    <section class="grid gap-6 xl:grid-cols-[360px_minmax(0,1fr)]">
                        <aside class="border border-ind-border/60 bg-black/35">
                            <div class="border-b border-ind-border/40 px-5 py-4">
                                <p class="text-[0.68rem] uppercase tracking-[0.16em] text-ind-accent/80">Recent chats</p>
                            </div>

                            <div class="max-h-[70vh] overflow-y-auto">
                                {sessions.length > 0 ? (
                                    sessions.map((session) => {
                                        const active = selectedSession?.sessionId === session.sessionId;
                                        const title = session.leadName ?? session.leadEmail ?? 'Anonymous visitor';
                                        const subline = session.summaryJson?.summary ?? session.challenge ?? 'No summary yet';

                                        return (
                                            <a
                                                href={buildSessionHref(session.sessionId)}
                                                class:list={[
                                                    'block border-b border-ind-border/30 px-5 py-4 transition-colors',
                                                    active ? 'bg-ind-accent/10' : 'hover:bg-white/5',
                                                ]}
                                            >
                                                <div class="flex items-start justify-between gap-3">
                                                    <div>
                                                        <div class="text-sm font-bold uppercase tracking-[0.08em] text-white">{title}</div>
                                                        <div class="mt-1 text-[0.65rem] uppercase tracking-[0.14em] text-ind-steel">
                                                            {formatTimestamp(session.updatedAt)}
                                                        </div>
                                                    </div>
                                                    <div
                                                        class:list={[
                                                            'shrink-0 border px-2 py-1 text-[0.58rem] font-bold uppercase tracking-[0.12em]',
                                                            session.booked
                                                                ? 'border-green-400/40 text-green-300'
                                                                : 'border-ind-border/50 text-ind-steel',
                                                        ]}
                                                    >
                                                        {session.booked ? 'Booked' : 'Open'}
                                                    </div>
                                                </div>
                                                <p class="mt-3 text-sm leading-6 text-ind-steel">{subline}</p>
                                            </a>
                                        );
                                    })
                                ) : (
                                    <div class="px-5 py-6 text-sm leading-6 text-ind-steel">No saved chats yet.</div>
                                )}
                            </div>
                        </aside>

                        <section class="border border-ind-border/60 bg-black/35 p-6">
                            {selectedSession ? (
                                <div class="space-y-6">
                                    <div>
                                        <p class="text-[0.68rem] uppercase tracking-[0.16em] text-ind-accent/80">Selected chat</p>
                                        <h2 class="mt-2 text-2xl font-black uppercase tracking-[0.08em] text-white">
                                            {selectedSession.leadName ?? selectedSession.leadEmail ?? 'Anonymous visitor'}
                                        </h2>
                                        <p class="mt-3 text-sm leading-6 text-ind-steel">
                                            Updated {formatTimestamp(selectedSession.updatedAt)}. Finalized{' '}
                                            {formatTimestamp(selectedSession.finalizedAt)}.
                                        </p>
                                    </div>

                                    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
                                        <div class="border border-ind-border/40 bg-[#111] p-4">
                                            <div class="text-[0.62rem] uppercase tracking-[0.14em] text-ind-steel">Lead email</div>
                                            <div class="mt-2 text-sm font-semibold text-white">
                                                {selectedSession.leadEmail ?? '—'}
                                            </div>
                                        </div>
                                        <div class="border border-ind-border/40 bg-[#111] p-4">
                                            <div class="text-[0.62rem] uppercase tracking-[0.14em] text-ind-steel">Timezone</div>
                                            <div class="mt-2 text-sm font-semibold text-white">
                                                {selectedSession.leadTimezone ?? '—'}
                                            </div>
                                        </div>
                                        <div class="border border-ind-border/40 bg-[#111] p-4">
                                            <div class="text-[0.62rem] uppercase tracking-[0.14em] text-ind-steel">Service</div>
                                            <div class="mt-2 text-sm font-semibold text-white">
                                                {selectedSession.serviceInterest ?? '—'}
                                            </div>
                                        </div>
                                        <div class="border border-ind-border/40 bg-[#111] p-4">
                                            <div class="text-[0.62rem] uppercase tracking-[0.14em] text-ind-steel">Summary email</div>
                                            <div class="mt-2 text-sm font-semibold text-white">
                                                {selectedSession.summarySentAt ? 'Sent' : 'Not sent yet'}
                                            </div>
                                        </div>
                                    </div>

                                    <div class="grid gap-4 lg:grid-cols-2">
                                        <div class="border border-ind-border/40 bg-[#111] p-5">
                                            <p class="text-[0.62rem] uppercase tracking-[0.14em] text-ind-accent/80">Conversation summary</p>
                                            <p class="mt-3 text-sm leading-7 text-white/90">
                                                {selectedSession.summaryJson?.summary ?? selectedSession.summary ?? 'No summary yet.'}
                                            </p>
                                            <dl class="mt-5 space-y-3 text-sm leading-6 text-ind-steel">
                                                <div>
                                                    <dt class="uppercase tracking-[0.12em] text-[0.62rem] text-ind-steel/80">Main pain</dt>
                                                    <dd class="mt-1 text-white/90">
                                                        {selectedSession.summaryJson?.ownerPain ?? selectedSession.challenge ?? '—'}
                                                    </dd>
                                                </div>
                                                <div>
                                                    <dt class="uppercase tracking-[0.12em] text-[0.62rem] text-ind-steel/80">Objection</dt>
                                                    <dd class="mt-1 text-white/90">
                                                        {selectedSession.summaryJson?.objection ?? '—'}
                                                    </dd>
                                                </div>
                                                <div>
                                                    <dt class="uppercase tracking-[0.12em] text-[0.62rem] text-ind-steel/80">Next step</dt>
                                                    <dd class="mt-1 text-white/90">
                                                        {selectedSession.summaryJson?.nextStep ?? '—'}
                                                    </dd>
                                                </div>
                                            </dl>
                                        </div>

                                        <div class="border border-ind-border/40 bg-[#111] p-5">
                                            <p class="text-[0.62rem] uppercase tracking-[0.14em] text-ind-accent/80">Improve Grant next time</p>
                                            <p class="mt-3 text-sm leading-7 text-white/90">
                                                {selectedSession.summaryJson?.noteToImproveGrant ??
                                                    'No coaching note yet. Once finalized, this chat will show one concrete improvement note for Grant.'}
                                            </p>
                                            <dl class="mt-5 grid gap-4 border-t border-ind-border/30 pt-4 text-sm leading-6 text-ind-steel md:grid-cols-3">
                                                <div>
                                                    <dt class="uppercase tracking-[0.12em] text-[0.62rem] text-ind-steel/80">Loss frame</dt>
                                                    <dd class="mt-1 text-white/90">
                                                        {selectedSession.summaryJson?.dominantLossFrame ?? '—'}
                                                    </dd>
                                                </div>
                                                <div>
                                                    <dt class="uppercase tracking-[0.12em] text-[0.62rem] text-ind-steel/80">Posture</dt>
                                                    <dd class="mt-1 text-white/90">
                                                        {selectedSession.summaryJson?.reactancePosture ?? '—'}
                                                    </dd>
                                                </div>
                                                <div>
                                                    <dt class="uppercase tracking-[0.12em] text-[0.62rem] text-ind-steel/80">Authority hook</dt>
                                                    <dd class="mt-1 text-white/90">
                                                        {selectedSession.summaryJson?.authorityHook ?? '—'}
                                                    </dd>
                                                </div>
                                            </dl>
                                            <div class="mt-5 border-t border-ind-border/30 pt-4">
                                                <p class="text-[0.62rem] uppercase tracking-[0.14em] text-ind-steel/80">Note to Greg</p>
                                                <p class="mt-2 text-sm leading-7 text-white/90">
                                                    {selectedSession.summaryJson?.noteToGreg ?? '—'}
                                                </p>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="border border-ind-border/40 bg-[#111] p-5">
                                        <p class="text-[0.62rem] uppercase tracking-[0.14em] text-ind-accent/80">Transcript</p>
                                        <div class="mt-4 space-y-3">
                                            {selectedSession.messages.map((message) => (
                                                <div
                                                    class:list={[
                                                        'border px-4 py-3 text-sm leading-7',
                                                        message.role === 'assistant'
                                                            ? 'border-ind-border/40 bg-black/30 text-white/90'
                                                            : 'border-ind-accent/30 bg-ind-accent/10 text-white',
                                                    ]}
                                                >
                                                    <div class="mb-2 text-[0.6rem] font-bold uppercase tracking-[0.14em] text-ind-accent/80">
                                                        {message.role === 'assistant' ? 'Grant' : 'Visitor'}
                                                    </div>
                                                    <div>{message.content}</div>
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            ) : (
                                <div class="text-sm leading-6 text-ind-steel">No session selected.</div>
                            )}
                        </section>
                    </section>
                </>
            )}
        </div>
    </main>
</IndustrialLayout>
