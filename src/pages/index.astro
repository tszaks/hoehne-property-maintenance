---
import IndustrialLayout from '../layouts/IndustrialLayout.astro';
import Navbar from '../components/industrial/Navbar.svelte';
import Hero from '../components/industrial/Hero.svelte';
import Services from '../components/industrial/Services.svelte';
import ClientLogos from '../components/industrial/ClientLogos.svelte';
import Process from '../components/industrial/Process.svelte';
import CaseStudies from '../components/industrial/CaseStudies.svelte';
import Team from '../components/industrial/Team.svelte';
import FAQ from '../components/industrial/FAQ.svelte';
import Contact from '../components/industrial/Contact.svelte';
import Footer from '../components/industrial/Footer.svelte';
import SmoothScroll from '../components/SmoothScroll.svelte';
import ScrollProgress from '../components/industrial/ScrollProgress.svelte';
import MouseTrail from '../components/industrial/MouseTrail.svelte';
import SectionIndicator from '../components/industrial/SectionIndicator.svelte';
import FloatingPhone from '../components/industrial/FloatingPhone.svelte';
---

<IndustrialLayout 
	title="Hoehne Property Maintenance & Remodeling | Pottstown, PA"
	description="Veteran-owned property maintenance and remodeling in Pottstown, PA. 20 years of experience. Handyman services, home renovations, painting, lawn care, snow removal. Call (610) 412-6424."
>
	<SmoothScroll client:only="svelte" />
	<ScrollProgress client:only="svelte" />
	<MouseTrail client:only="svelte" />
	<SectionIndicator client:only="svelte" />
	
	<main class="relative bg-ind-bg selection:bg-ind-accent selection:text-black">
		<Navbar client:load />
		<Hero client:load />
		<Services client:visible />
		<ClientLogos client:visible />
		<Process client:visible />
		<CaseStudies client:visible />
		<Team client:visible />
		<FAQ client:visible />
		<Contact client:visible />
		<Footer client:visible />
	</main>
	<FloatingPhone client:load />
</IndustrialLayout>
